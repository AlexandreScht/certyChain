# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# Single .gitignore for the whole monorepo: root web app + every pnpm workspace
# member (server/, admin/, wallet/). Patterns below are UNANCHORED (no leading
# slash) on purpose so they match at any depth — one file to maintain instead of
# one per package (a missing per-package .gitignore is exactly what let
# `git add .` stage server/node_modules once). Do not add per-package
# .gitignore files back — extend this one instead.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# build output (server tsup dist/, etc.)
dist/
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# history
.history
