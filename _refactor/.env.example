# ─────────────────────────────────────────────────────────────────────────────
# CertifyChain — variables d'environnement (copier en `.env` et renseigner).
# Ne JAMAIS committer `.env`. Régénérer tous les secrets pour la production.
#
# ⚠️ CE FICHIER NE CONTIENT QUE DES SECRETS (ou des identifiants propres au
#    déploiement). Toute la config NON sensible (ports, origines, TTL, modèle
#    Gemini, tarifs postaux, issuer ProConnect…) est dans les fichiers
#    `docker-compose.yml` (prod) et `docker-compose-dev.yml` (dev), où elle est
#    versionnée et surchargeable par variable shell — voir la convention en tête
#    de `docker-compose.yml`.
#
# 📄 Obtenir les clés ProConnect / Stripe : voir `GUIDE_PROCONNECT_STRIPE.md`.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Mot de passe (secret) consommé par docker-compose ET par DATABASE_URL.
POSTGRES_PASSWORD=change-me-strong-password
# Chaîne de connexion pour le DEV LOCAL (`pnpm stack:dev`, scripts db:*).
# En local : host = localhost. En docker-compose, l'API la reçoit déjà câblée
# vers le host "db" (tu n'as pas à la changer pour Docker).
DATABASE_URL=postgresql://certify:change-me-strong-password@localhost:5432/certifychain

# ── Sessions (secrets JWT) — générer : `openssl rand -base64 48` ─────────────
JWT_ACCESS_SECRET=replace-with-openssl-rand-base64-48
JWT_REFRESH_SECRET=replace-with-another-openssl-rand-base64-48

# ── Chiffrement au repos + OTP (secrets) ─────────────────────────────────────
# Clé maître 32 octets base64 (AES-256-GCM) — `openssl rand -base64 32`
MASTER_ENC_KEY=replace-with-openssl-rand-base64-32
# Poivre du hash des OTP — `openssl rand -base64 32`
OTP_PEPPER=replace-with-openssl-rand-base64-32
# Sel dédié à la pseudonymisation des IP dans l'audit (RGPD). Si vide, retombe
# sur OTP_PEPPER ; définir une valeur DISTINCTE (≥ 16 car.) avant de traiter de
# vraies données — `openssl rand -base64 32`.
AUDIT_IP_SALT=

# ── Racine PKI CertifyChain (signe les certificats des écoles) ────────────────
# Paire Ed25519 base64, générée ensemble via :
#   `pnpm --filter @certifychain/server keys:root`
# (La clé publique n'est pas secrète mais reste ici, couplée à la privée.)
CERTIFYCHAIN_ROOT_PUBLIC_KEY=replace-with-generated-ed25519-public-key-b64
CERTIFYCHAIN_ROOT_PRIVATE_KEY=replace-with-generated-ed25519-private-key-b64

# ── Email (provider SMTP) ────────────────────────────────────────────────────
# Vide → les emails (codes OTP, notifications) s'affichent dans les logs.
# DEV : lance Mailpit (docker-compose-dev) → l'API pointe déjà vers `mailpit`.
#   Pour `pnpm stack:dev` local : SMTP_HOST=localhost / SMTP_PORT=1025, mails sur
#   http://localhost:8025.
# PROD : SMTP_HOST/PORT/USER/PASSWORD du provider + SMTP_SECURE=true (TLS 465).
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM="CertifyChain <no-reply@certifychain.local>"

# ── Clés API (secrets) ───────────────────────────────────────────────────────
# Registre SIRENE (INSEE) — SOURCE DE VÉRITÉ pour la validation d'école.
# Clé sur https://portail-api.insee.fr (souscrire à « API Sirene (Sirene 4 - v3.11) »).
# Vide → la vérification SIRENE est ignorée (repli IA/manuel).
INSEE_API_KEY=
# Vérificateur IA (Google Gemini). Clé via https://aistudio.google.com/apikey
# Vide → repli sur un score de plausibilité, sinon revue manuelle (score null).
GEMINI_API_KEY=

# ── ProConnect (DINUM, OIDC) — voir GUIDE_PROCONNECT_STRIPE.md §1 ────────────
# Preuve de propriété FORTE : l'État atteste l'identité + le SIRET de l'agent.
# App OIDC créée sur https://partenaires.proconnect.gouv.fr (intégration immédiate).
# Vide → l'option ProConnect n'est pas proposée. (En docker-compose-dev, un mock
# local rend l'option testable sans aucune clé réelle.)
PROCONNECT_CLIENT_ID=
PROCONNECT_CLIENT_SECRET=

# ── Stripe (courrier postal payant) — voir GUIDE_PROCONNECT_STRIPE.md §2 ─────
# Clés sur https://dashboard.stripe.com (mode test gratuit). Le webhook signe les
# événements de paiement. Vide → l'option « courrier postal » n'est pas proposée.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Bootstrap admin plateforme (créé au démarrage s'il n'existe pas) ─────────
# TOTP enrôlé au premier login (scan du QR affiché par le portail). MDP ≥ 12 car.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
