# ─────────────────────────────────────────────────────────────────────────────
# CertifyChain — variables d'environnement (copier en `.env` et renseigner).
# Ne JAMAIS committer `.env`. Régénérer tous les secrets pour la production.
#
# ⚠️ CE FICHIER CONTIENT PRINCIPALEMENT LES SECRETS (ou identifiants propres au
#    déploiement), plus les quelques options nécessaires aux scripts locaux
#    (`CDC_RETENTION_DAYS`, `PUBLIC_API_ORIGIN`, `VC_EXPORT_ENABLED`). Le reste de
#    la config NON sensible (ports, TTL, modèle Gemini, tarifs postaux, issuer
#    ProConnect…) vit dans `docker-compose.yml` et `docker-compose-dev.yml`.
#
# 📄 Obtenir les clés ProConnect / Stripe : voir `GUIDE_PROCONNECT_STRIPE.md`.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Mot de passe (secret) consommé par docker-compose ET par DATABASE_URL.
POSTGRES_PASSWORD=change-me-strong-password
# Chaîne de connexion pour le DEV LOCAL (`pnpm stack:dev`, scripts db:*).
# En local : host = localhost. En docker-compose, l'API la reçoit déjà câblée
# vers le host "db" (tu n'as pas à la changer pour Docker).
DATABASE_URL=postgresql://certify:change-me-strong-password@localhost:5432/certifychain

# ── Sessions (secrets JWT) — générer : `openssl rand -base64 48` ─────────────
JWT_ACCESS_SECRET=replace-with-openssl-rand-base64-48
JWT_REFRESH_SECRET=replace-with-another-openssl-rand-base64-48

# ── Chiffrement au repos + OTP (secrets) ─────────────────────────────────────
# Clé maître 32 octets base64 (AES-256-GCM) — `openssl rand -base64 32`
MASTER_ENC_KEY=replace-with-openssl-rand-base64-32
# Poivre du hash des OTP — `openssl rand -base64 32`
OTP_PEPPER=replace-with-openssl-rand-base64-32
# Sel DÉDIÉ à la pseudonymisation des IP dans l'audit (RGPD) — OBLIGATOIRE
# (≥ 16 car.), sans repli sur OTP_PEPPER. Distinct de tous les autres secrets
# de ce fichier — `openssl rand -base64 32`. Note : ce n'est pas une clé mais
# un pseudonyme ; le faire tourner est possible mais casse la corrélation des
# hachages d'IP déjà enregistrés (documenter la rotation si elle a lieu).
AUDIT_IP_SALT=replace-with-openssl-rand-base64-32

# NIR/identity retention after a CDC-accepted passage (days).
CDC_RETENTION_DAYS=30

# ── Export EUDI Wallet (OpenID4VCI / SD-JWT VC, non sensible) ───────────────
# Origine publique nue de l'API, utilisée comme identifiant cryptographique
# d'émetteur. En production : URL HTTPS exposée derrière le reverse proxy.
# En local, préférer 127.0.0.1 à `localhost` : c'est l'URL que le CLIENT rappelle
# (offre OpenID4VCI, `revocation.source`), et le résolveur de Node essaie ::1
# avant 127.0.0.1 alors que Docker ne publie les ports qu'en IPv4.
PUBLIC_API_ORIGIN=http://127.0.0.1:4000
# L'émission exige aussi une clé active en base (`pnpm ... keys:vc`).
VC_EXPORT_ENABLED=false

# ── V2 — Couture Signer (clés d'école hors-base) ────────────────────────────
# Où vivent les clés privées d'émission des écoles.
#   envelope (défaut) = blob AES-256-GCM en base, comportement historique.
#   kms               = HashiCorp Vault Transit (Ed25519) — la clé ne sort jamais
#                       du coffre. Requiert VAULT_ADDR + VAULT_TOKEN ci-dessous.
# Les deux backends coexistent école par école : basculer en kms n'affecte que
# les écoles approuvées APRÈS la bascule (aucune migration des clés existantes).
SIGNER_KIND=envelope
# Adresse du serveur Vault (NON sensible, surchargeable en compose). Requis si kms.
VAULT_ADDR=
# Jeton d'accès Vault (SECRET). Requis si SIGNER_KIND=kms.
VAULT_TOKEN=
# Montage du moteur Transit + préfixe des noms de clés (NON sensibles).
VAULT_TRANSIT_MOUNT=transit
VAULT_KEY_PREFIX=certifychain-school

# ── V3 — Ancrage du journal de transparence (OpenTimestamps) ─────────────────
# Liste CSV de calendriers OTS publics (NON sensible). Vide → ancrage désactivé
# (dégradation propre : les checkpoints restent signés par la racine, sans preuve
# Bitcoin). Les trois calendriers publics de référence :
OTS_CALENDARS=https://a.pool.opentimestamps.org,https://b.pool.opentimestamps.org,https://finney.calendar.eternitywall.com

# ── V4 — Post-quantique hybride (ML-DSA-65 / FIPS 204) ───────────────────────
# ⚠️ DÉFAUT = require DEPUIS 2026-07-28 (décision produit : la page publique
# annonce déjà la puce « Post-quantique · ML-DSA », FeaturesGrid.tsx:402 — le
# serveur ne doit jamais délivrer de diplôme qui ne tienne pas cette promesse).
# CONSÉQUENCE : LE SERVEUR NE DÉMARRE PAS (fail-fast, config/env.ts superRefine)
# tant que CERTIFYCHAIN_ROOT_PQ_PUBLIC_KEY / _PRIVATE_KEY ci-dessous n'ont pas
# une paire ML-DSA-65 valide. Génère-la AVANT le premier démarrage avec :
#   pnpm --filter @certifychain/server keys:root:pq
# (le message d'erreur au boot rappelle cette commande si tu l'oublies).
#
# off        = comportement legacy, aucune signature ML-DSA nulle part — à ne
#              choisir qu'en connaissance de cause (dev/démo rapide), car cela
#              contredit la puce « post-quantique » affichée sur le site public.
# dual-sign  = nouveaux diplômes/certificats d'école/checkpoints du journal
#              signés EN PLUS en ML-DSA-65 (proof_version='v3') ; les
#              diplômes v1/v2 déjà émis restent inchangés et se vérifient
#              comme avant, à vie.
# require    = (DÉFAUT) même émission que dual-sign, mais un échec de
#              signature/génération de clé PQ fait ÉCHOUER l'émission plutôt
#              que de retomber silencieusement sur v2.
PQ_POLICY=require
# Paire ML-DSA-65 base64 de la racine PKI (aucune convention PEM/SPKI pour
# ML-DSA), générée via : `pnpm --filter @certifychain/server keys:root:pq`.
# Requises dès que PQ_POLICY ≠ off — donc REQUISES PAR DÉFAUT (vérifié au
# boot, fail-fast, message d'erreur explicite dans config/env.ts).
# ⚠️ CERTIFYCHAIN_ROOT_PQ_PUBLIC_KEY accepte la MÊME liste CSV que
# CERTIFYCHAIN_ROOT_PUBLIC_KEY ci-dessous (même convention : 1ʳᵉ entrée =
# racine qui signe, entrées suivantes = racines PQ sortantes encore
# vérifiables) — voir docs/security/root-secrets-rotation.md §4.
# CERTIFYCHAIN_ROOT_PQ_PRIVATE_KEY reste unique, comme CERTIFYCHAIN_ROOT_
# PRIVATE_KEY.
CERTIFYCHAIN_ROOT_PQ_PUBLIC_KEY=
CERTIFYCHAIN_ROOT_PQ_PRIVATE_KEY=

# ── Racine PKI CertifyChain (signe les certificats des écoles) ────────────────
# Paire Ed25519 base64, générée ensemble via :
#   `pnpm --filter @certifychain/server keys:root`
# (La clé publique n'est pas secrète mais reste ici, couplée à la privée.)
#
# ⚠️ ROTATION (audit 2026-07-28, docs/security/root-secrets-rotation.md §4) —
# CERTIFYCHAIN_ROOT_PUBLIC_KEY accepte désormais une LISTE CSV (comme
# NEXT_PUBLIC_CERTIFYCHAIN_ROOT_PUBLIC_KEY côté navigateur, ci-dessous : même
# encodage, un opérateur copie les mêmes valeurs des deux côtés sans rien
# re-dériver). Une valeur unique sans virgule (le cas de TOUS les `.env`
# existants) continue de fonctionner à l'identique. CERTIFYCHAIN_ROOT_PRIVATE_KEY
# reste TOUJOURS unique : on ne signe qu'avec UNE seule racine à la fois — la
# vérification, elle, accepte plusieurs racines. Convention non ambiguë : la
# PREMIÈRE entrée de la liste CSV est celle que CERTIFYCHAIN_ROOT_PRIVATE_KEY
# signe réellement ; toute entrée suivante n'existe que pour continuer à
# vérifier les certificats d'école signés par une racine SORTANTE, le temps
# d'une fenêtre de coexistence (voir la cérémonie complète dans le fichier cité
# plus haut) — potentiellement indéfiniment (CLAUDE.md §1 : « la preuve est
# autonome »).
CERTIFYCHAIN_ROOT_PUBLIC_KEY=replace-with-generated-ed25519-public-key-b64
CERTIFYCHAIN_ROOT_PRIVATE_KEY=replace-with-generated-ed25519-private-key-b64

# ⚠️ ÉPINGLAGE NAVIGATEUR (audit 2026-07-27) — CETTE clé publique (et, PQ_POLICY
# étant require PAR DÉFAUT, quasi-systématiquement CERTIFYCHAIN_ROOT_PQ_PUBLIC_KEY
# ci-dessus aussi) est AUSSI la racine que les 3 fronts Next.js épinglent en dur, au BUILD, via les build-args
# Docker NEXT_PUBLIC_CERTIFYCHAIN_ROOT_PUBLIC_KEY / NEXT_PUBLIC_CERTIFYCHAIN_
# ROOT_PQ_PUBLIC_KEY (voir docker-compose.yml, qui les réutilise TELLES QUELLES
# depuis ce fichier — ne pas les redéfinir séparément). Sans cet épinglage, le
# vérificateur `/verifier` (`apps/client/web`) validerait une preuve contre la
# racine PORTÉE PAR LA PREUVE ELLE-MÊME : un faussaire n'aurait qu'à générer sa
# propre paire de clés racine pour que sa preuve forgée se vérifie contre
# elle-même (voir `docs/architecture/decisions/0007-browser-root-pinning.md`).
# Avant ce correctif, AUCUNE racine n'était épinglée côté navigateur.
#
# CONSÉQUENCE OPÉRATIONNELLE : une rotation de CETTE clé racine (docs/security/
# root-secrets-rotation.md §4) exige un REBUILD des 3 images fronts
# (web/wallet/admin), pas seulement un redéploiement/restart — `NEXT_PUBLIC_*`
# est figé dans le bundle JS à la compilation par Next.js, jamais relu au
# runtime. Un simple `docker compose up` sans rebuild continuerait de vérifier
# contre l'ANCIENNE racine tant que les images ne sont pas reconstruites.
#
# CÔTÉ SERVEUR (audit 2026-07-28) : `CERTIFYCHAIN_ROOT_PUBLIC_KEY` /
# `CERTIFYCHAIN_ROOT_PQ_PUBLIC_KEY` acceptent la MÊME liste CSV que les
# variables `NEXT_PUBLIC_*` ci-dessous — pendant la fenêtre de coexistence,
# mets EXACTEMENT la même valeur `ancienne,nouvelle` des deux côtés. Avant ce
# correctif, le serveur n'épinglait qu'UNE seule racine
# (`apps/server/src/modules/verify/verify.routes.ts`, `SERVER_TRUSTED_ROOTS`) :
# basculer la clé privée cassait aussitôt la vérification de tout certificat
# d'école signé sous l'ancienne racine. Ce n'est plus le cas.
#
# Si ces valeurs sont absentes au moment du build des fronts (variable non
# définie dans ce `.env` au build), le vérificateur navigateur refuse
# EXPLICITEMENT toute preuve (« no trusted CertifyChain root configured ») —
# jamais un repli silencieux vers « on fait confiance à la racine de la preuve ».
# ⚠️ Avec PQ_POLICY=require (défaut), TOUS les diplômes émis sont hybrides
# (`ed25519-sd-v3`) : si NEXT_PUBLIC_CERTIFYCHAIN_ROOT_PQ_PUBLIC_KEY est vide
# au build, la liste `mlDsa65` des racines épinglées est vide et
# `packages/shared/src/crypto/verify-bundle.ts` rejette 100 % des preuves
# dans le navigateur (fail-closed voulu — pas un bug si tu le constates,
# mais vérifie alors que ce build-arg est bien transmis par le compose).

# ── Email (provider SMTP) ────────────────────────────────────────────────────
# Vide → les emails (codes OTP, notifications) s'affichent dans les logs.
# DEV : lance Mailpit (docker-compose-dev) → l'API pointe déjà vers `mailpit`.
#   Pour `pnpm stack:dev` local : SMTP_HOST=localhost / SMTP_PORT=1025, mails sur
#   http://localhost:8025.
# PROD : deux modes TLS, mutuellement exclusifs (voir smtp.ts / config/env.ts) :
#   • TLS implicite (port 465, ex. Resend/Mailgun/SendGrid/Postmark) :
#       SMTP_SECURE=true / SMTP_STARTTLS=false
#   • STARTTLS (port 587 — ex. Ethereal, et l'autre option de la plupart des
#     providers ci-dessus) : connexion en clair puis élévation ; le client
#     refuse d'envoyer les identifiants si le serveur n'annonce pas STARTTLS
#     dans ses capacités EHLO — jamais de repli silencieux vers du clair :
#       SMTP_SECURE=false / SMTP_STARTTLS=true
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_STARTTLS=false
SMTP_FROM="CertifyChain <no-reply@certifychain.local>"

# ── Clés API (secrets) ───────────────────────────────────────────────────────
# Registre SIRENE (INSEE) — SOURCE DE VÉRITÉ pour la validation d'école.
# Clé sur https://portail-api.insee.fr (souscrire à « API Sirene (Sirene 4 - v3.11) »).
# Vide → la vérification SIRENE est ignorée (repli IA/manuel).
INSEE_API_KEY=
# Vérificateur IA (Google Gemini). Clé via https://aistudio.google.com/apikey
# Vide → repli sur un score de plausibilité, sinon revue manuelle (score null).
GEMINI_API_KEY=

# ── ProConnect (DINUM, OIDC) — voir GUIDE_PROCONNECT_STRIPE.md §1 ────────────
# Preuve de propriété FORTE : l'État atteste l'identité + le SIRET de l'agent.
# App OIDC créée sur https://partenaires.proconnect.gouv.fr (intégration immédiate).
# Vide → l'option ProConnect n'est pas proposée. (En docker-compose-dev, un mock
# local rend l'option testable sans aucune clé réelle.)
PROCONNECT_CLIENT_ID=
PROCONNECT_CLIENT_SECRET=

# ── Stripe (courrier postal payant) — voir GUIDE_PROCONNECT_STRIPE.md §2 ─────
# Clés sur https://dashboard.stripe.com (mode test gratuit). Le webhook signe les
# événements de paiement. Vide → l'option « courrier postal » n'est pas proposée.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Bootstrap admin plateforme (créé au démarrage s'il n'existe pas) ─────────
# TOTP enrôlé au premier login (scan du QR affiché par le portail). MDP ≥ 12 car.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
