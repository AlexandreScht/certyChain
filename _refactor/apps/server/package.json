{
  "name": "@certifychain/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CertifyChain API — Hono backend (issuance, wallet, verification, audit)",
  "exports": {
    "./rpc": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.cjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --env-file=../../.env --test \"test/**/*.test.ts\"",
    "smoke": "tsx --env-file=../../.env src/scripts/smoke.ts",
    "test:crypto-selftest": "tsx --env-file=../../.env src/scripts/crypto-selftest.ts",
    "test:gemini": "tsx --env-file=../../.env src/scripts/test-gemini.ts",
    "test:sirene": "tsx --env-file=../../.env src/scripts/test-sirene.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/scripts/migrate-cli.ts",
    "db:seed": "tsx --env-file=../../.env src/scripts/seed.ts",
    "seed:admin": "tsx --env-file=../../.env src/scripts/seed-admin.ts",
    "keys:root": "tsx src/scripts/gen-root-keys.ts",
    "keys:root:pq": "tsx src/scripts/gen-root-keys-pq.ts",
    "keys:vc": "tsx --env-file=../../.env src/scripts/gen-vc-issuer-key.ts"
  },
  "dependencies": {
    "@certifychain/contract": "workspace:*",
    "@certifychain/shared": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.1",
    "drizzle-orm": "^0.38.2",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.30.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
